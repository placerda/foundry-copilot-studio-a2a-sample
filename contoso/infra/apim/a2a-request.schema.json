{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["jsonrpc", "id", "method", "params"],
  "properties": {
    "jsonrpc": {"type": "string", "enum": ["2.0"]},
    "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "method": {"type": "string", "enum": ["SendMessage"]},
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "configuration"],
      "properties": {
        "message": {
          "type": "object",
          "additionalProperties": false,
          "required": ["messageId", "role", "parts"],
          "properties": {
            "messageId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
            "role": {"type": "string", "enum": ["ROLE_USER"]},
            "parts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["text"],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "pattern": "^(?=[\\s\\S]*\\S)[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]+$"
                  }
                }
              }
            }
          }
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["acceptedOutputModes", "returnImmediately"],
          "properties": {
            "acceptedOutputModes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {"type": "string", "enum": ["text/plain"]}
            },
            "returnImmediately": {"type": "boolean", "enum": [false]}
          }
        }
      }
    }
  }
}
